# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
.codex/
# Python
__pycache__/
*.pyc
.venv/
.venv*/
.env
# R
.Rhistory
.RData
.rdb
.rds
.rdx
.Rproj.user/
*.Rproj
.Rlibs/
.so
# Large bioinformatics artefacts (never commit)
*.fastq
*.fastq.gz
*.fq.gz
*.bam
*.bai
*.cram
*.crai
*.vcf
*.vcf.gz
*.tbi
*.g.vcf.gz
*.bcf
*.sam
*.metrics
*.pdf
*.png
*.jpg
*.jpeg
*.zip
*.tar
*.tar.gz
# Large reference resources (do not commit)
resources/*.fa
resources/*.fa.gz
resources/*.fasta
resources/*.fasta.*
resources/*.vcf
resources/*.vcf.gz
resources/*.vcf.gz.tbi
resources/*.vcf.idx
resources/*.gtf.gz
# If you keep indexes with big VCFs, ignore those too
resources/*.tbi
resources/*.idx
resources/funcotator_data_somatic/
resources/backup/funcotator_excluded_datasources/
# Keep small, hand-authored resource descriptors
!resources/README.md
!resources/backup/README.md
!resources/*.bed
!resources/*.interval_list
!resources/*.dict
!resources/*.fai
# Junction reference runtime index sidecars
resources/junctions/*.fa.amb
resources/junctions/*.fa.ann
resources/junctions/*.fa.bwt
resources/junctions/*.fa.pac
resources/junctions/*.fa.sa
# Data policy (large inputs remain untracked)
data/raw/
data/fastq/
data/bam/
data/cram/
data/vcf/
# Results are tracked by default; large artefacts are still ignored by the
# global patterns above (e.g. *.bam, *.bai, *.cram, *.vcf, *.fastq, *.pdf, *.png).
# Allow placeholders to remain tracked
!data/.gitkeep
# Repeat workflow keeps summary TSVs in git, but raw caller outputs, reviewer
# artifacts, logs, and archived runs stay local because they are very large.
results/repeats/raw/
results/repeats/review/
results/repeats/logs/
results/repeats/old_runs/
# Manual mosaic review keeps cohort-level summary TSVs in git, but the detailed
# per-read/per-sample review artefacts are regenerated locally when needed.
results/repeats/manual/
results/repeats/manual_cohort/*/samples/
# Logs
v*.log
*.log.*
nohup.out
# Raw FASTQ data (large; keep out of git)
/fastq/
# Pipeline run outputs (large; keep out of git)
/runs/*
!/runs/README.md
/run/
config/preprocessing.env
config/junctions.env
# Personal journal notes and plans
doc/journal/
doc/plans/

# Manuscript workspace (temporarily excluded from version control)
/manuscript/
