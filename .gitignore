# Large reference resources; small hand-authored descriptors stay trackable.
resources/*.fa
resources/*.fa.gz
resources/*.fasta
resources/*.fasta.*
resources/*.vcf
resources/*.vcf.gz
resources/*.vcf.gz.tbi
resources/*.vcf.idx
resources/*.gtf.gz
resources/*.tbi
resources/*.idx
resources/funcotator_data_somatic/
resources/backup/funcotator_excluded_datasources/
!resources/README.md
!resources/backup/README.md
!resources/*.bed
!resources/*.interval_list
!resources/*.dict
!resources/*.fai

# Junction reference runtime index sidecars
resources/junctions/*.fa.amb
resources/junctions/*.fa.ann
resources/junctions/*.fa.bwt
resources/junctions/*.fa.pac
resources/junctions/*.fa.sa

# Raw/private input data
/raw/fastq/
/raw/dna_quality/
/raw/ddpcr/*
!/raw/ddpcr/
!/raw/ddpcr/README.md
/raw/ddpcr_lod/*
!/raw/ddpcr_lod/
!/raw/ddpcr_lod/README.md
/raw/ddpcr_original/
/deposition/

# Generated outputs kept local unless explicitly tracked already.
/results/ddPCR/dpcp/
/results/ddPCR/umbrella/
/results/ddPCR/logs/
/results/ddPCR/scatterplots/**/*.svg
/results/ddPCR/panels/**/*.svg

# Repeat workflow: keep text artefacts trackable, but ignore heavy review data
# and archived runs.
results/repeats/raw/*
!results/repeats/raw/expansionhunter/
!results/repeats/raw/expansionhunter/**/
!results/repeats/raw/expansionhunter/**/*.json
!results/repeats/raw/expansionhunter/**/*.vcf
!results/repeats/raw/gangstr/
!results/repeats/raw/gangstr/**/
!results/repeats/raw/gangstr/**/*.vcf
!results/repeats/raw/gangstr/**/*.tab
results/repeats/review/*
!results/repeats/review/reviewer/
!results/repeats/review/reviewer/**/
results/repeats/review/reviewer/**/*.svg
!results/repeats/review/reviewer/**/*.metrics.tsv
!results/repeats/review/reviewer/**/*.phasing.tsv
results/repeats/logs/*
!results/repeats/logs/*.log
results/repeats/old_runs/

# Manual repeat-review TSV artefacts can be tracked; per-sample bulk folders stay
# local.
results/repeats/manual/*
!results/repeats/manual/*.tsv
results/repeats/manual_cohort/*/samples/*
!results/repeats/manual_cohort/*/samples/*.tsv

# Runtime run directories and local pipeline config
/runs/*
!/runs/README.md
/run/

# Private reproducibility support memo
/reproducibility/a117v_reviewer_defensibility_package.md

# Manuscript workspace
/manuscript/
