# Large bioinformatics artefacts (never commit)
*.fastq
*.fastq.gz
*.fq.gz
*.bam
*.bai
*.cram
*.crai
*.vcf
*.vcf.gz
*.tbi
*.g.vcf.gz
*.bcf
*.sam
*.metrics
*.pdf
*.png
*.jpg
*.jpeg
*.zip
*.tar
*.tar.gz

# Large reference resources (do not commit)
resources/*.fa
resources/*.fa.gz
resources/*.fasta
resources/*.fasta.*
resources/*.vcf
resources/*.vcf.gz
resources/*.vcf.gz.tbi
resources/*.vcf.idx
resources/*.gtf.gz

# If you keep indexes with big VCFs, ignore those too
resources/*.tbi
resources/*.idx
resources/funcotator_data_somatic/
resources/backup/funcotator_excluded_datasources/

# Keep small, hand-authored resource descriptors
!resources/README.md
!resources/backup/README.md
!resources/*.bed
!resources/*.interval_list
!resources/*.dict
!resources/*.fai

# Junction reference runtime index sidecars
resources/junctions/*.fa.amb
resources/junctions/*.fa.ann
resources/junctions/*.fa.bwt
resources/junctions/*.fa.pac
resources/junctions/*.fa.sa

# Data policy (large inputs remain untracked)
data/raw/
data/fastq/
data/bam/
data/cram/
data/vcf/
legacy/

# Results are tracked by default; large artefacts are still ignored by the
# global patterns above (e.g. *.bam, *.bai, *.cram, *.vcf, *.fastq, *.pdf, *.png).
# Allow placeholders to remain tracked
!data/.gitkeep

# Repeat workflow keeps text artefacts in git for cross-machine review, but
# heavyweight realigned BAMs, REViewer SVGs, and archived runs stay local.
results/repeats/raw/*
!results/repeats/raw/expansionhunter/
!results/repeats/raw/expansionhunter/**/
!results/repeats/raw/expansionhunter/**/*.json
!results/repeats/raw/expansionhunter/**/*.vcf
!results/repeats/raw/gangstr/
!results/repeats/raw/gangstr/**/
!results/repeats/raw/gangstr/**/*.vcf
!results/repeats/raw/gangstr/**/*.tab
results/repeats/review/*
!results/repeats/review/reviewer/
!results/repeats/review/reviewer/**/
results/repeats/review/reviewer/**/*.svg
!results/repeats/review/reviewer/**/*.metrics.tsv
!results/repeats/review/reviewer/**/*.phasing.tsv
results/repeats/logs/*
!results/repeats/logs/*.log
results/repeats/old_runs/

# Manual mosaic review keeps TSV artefacts in git, but archived runs above stay
# local because they are much larger and easy to regenerate.
results/repeats/manual/*
!results/repeats/manual/*.tsv
results/repeats/manual_cohort/*/samples/*
!results/repeats/manual_cohort/*/samples/*.tsv

# Logs
v*.log
*.log.*
nohup.out

# Raw input data (large; keep out of git)
/raw/fastq/
/raw/dna_quality/
/raw/ddpcr/*.csv
/raw/ddpcr/*.xlsx

# Pipeline run outputs (large; keep out of git)
/runs/*
!/runs/README.md
/run/
config/preprocessing.env
config/junctions.env

# Personal journal notes and plans
doc/plans/
doc/notes/
doc/JOURNAL.md
doc/reproducibility/a117v_reviewer_defensibility_package.md

