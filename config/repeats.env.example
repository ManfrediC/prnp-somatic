# Paths are interpreted relative to repository root unless absolute.

REPEAT_BAM_DIR="results/final_bam"
REPEAT_RESULTS_ROOT="results/repeats"
REPEAT_REF_FASTA="resources/chr2_chr4_chr20.fasta"
PRNP_ORR_BED="resources/prnp_orr.hg38.bed"
PRNP_EH_CATALOG="resources/repeats/prnp_orr.expansionhunter.json"
REVIEWER_CONDA_ENV="prnp-reviewer"

# PRNP ORR bookkeeping:
# ExpansionHunter will estimate the variable middle repeat block.
# Convert ExpansionHunter allele counts to total PRNP ORR repeat counts by:
# total_repeat_count = middle_repeat_count + PRNP_VARIABLE_REPEAT_OFFSET
PRNP_TOTAL_REFERENCE_REPEATS=5
PRNP_VARIABLE_REPEAT_OFFSET=3

REPEAT_THREADS=4
ORR_MIN_READS=10
RUN_REVIEWER=1
FORCE=0
ARCHIVE_EXISTING_RUN=0
ARCHIVE_RUN_LABEL=""
EXPECTED_SAMPLE_COUNT=32
