# Optional configuration for src2/sequencing2.
# Copy this file to sequencing2.env and adjust values as needed.

# Shared inputs
FINAL_BAM_DIR="results/final_bam"
REF_FASTA="resources/references/snv/chr2_chr4_chr20.fasta"
INTERVALS="resources/intervals/capture_targets.interval_list"
GNOMAD_VCF="resources/population/somatic-hg38_af-only-gnomad.hg38.vcf.gz"
GNOMAD_AF_VCF="resources/population/somatic-hg38_af-only-gnomad.hg38.vcf.gz"
FUNCOTATOR_DS="resources/funcotator/funcotator_dataSources.v1.8.hg38.20230908s/hg38"
MANUAL_POP_FREQ_TSV="resources/annotations/manual_population_freq.tsv"

# Isolated controls branch and Panel of Normals
MUTECT2_CONTROLS_OUT_ROOT="results2/sequencing2/runs/mutect2_controls_no_pon"
VARIANT_QC_ROOT="results2/sequencing2/runs/mutect2_controls_no_pon/variant_qc"
VARIANT_QC_VCF_DIR="results2/sequencing2/runs/mutect2_controls_no_pon/annot_with_gnomad"
VARIANT_QC_READCOUNT_METRICS_DIR="results2/sequencing2/runs/mutect2_controls_no_pon/readcount_qc/metrics"
VARIANT_QC_OUTPUT_DIR="results2/sequencing2/results/mutect2_controls_no_pon/variant_qc"
VARIANT_QC_R_SCRIPT="src2/sequencing2/6_controls_variant_table_qc_no_pon.R"
PON_INPUT_DIR="results2/sequencing2/runs/mutect2_controls_no_pon/filtered"
PON_OUTPUT_ROOT="results2/sequencing2/results/mutect2_controls_pon/panel_of_normals"
PON_MERGED_VCF="results2/sequencing2/results/mutect2_controls_pon/panel_of_normals/controls_multisample.filtered.vcf.gz"
PON_VCF="results2/sequencing2/results/mutect2_controls_pon/panel_of_normals/CJD_controls_PoN.vcf.gz"
PON_CONTROLS="Ctrl1 Ctrl2 Ctrl3 Ctrl4 Ctrl5 Ctrl7"

# Isolated CJD and dilution branch
MUTECT2_WITH_PON_OUT_ROOT="results2/sequencing2/runs/mutect2_cjd_dilutions_with_pon"
MUTECT2_WITH_PON_POSTPROCESS_ROOT="results2/sequencing2/runs/mutect2_cjd_dilutions_with_pon"
MUTECT2_WITH_PON_READCOUNT_ROOT="results2/sequencing2/runs/mutect2_cjd_dilutions_with_pon"
MUTECT2_WITH_PON_VARIANT_QC_ROOT="results2/sequencing2/runs/mutect2_cjd_dilutions_with_pon"
WITH_PON_GROUPS="cjd dilutions"
WITH_PON_READCOUNT_GROUPS="cjd dilutions"
WITH_PON_READCOUNT_BAM_DIR="results/final_bam"
WITH_PON_READCOUNT_REF_FASTA="resources/references/snv/chr2_chr4_chr20.fasta"
WITH_PON_VARIANT_QC_GROUPS="cjd dilutions"
WITH_PON_VARIANT_QC_RESULTS_ROOT="results2/sequencing2/results/mutect2_cjd_dilutions_with_pon/variant_qc"
WITH_PON_VARIANT_QC_R_SCRIPT="src2/sequencing2/12_cjd_dilutions_variant_table_qc_with_pon.R"
READCOUNT_TO_TSV_PY="src2/sequencing2/4_readcount_to_tsv.py"
DILUTION_SAMPLES="NA100_undil NA100_1to10 NA99A1_undil A100_1to2 NA99A1_1to5 NA995A05_undil NA100_1to2"

# Fixed analytical LoD; stages 5 and 12 reject a different value.
ENABLE_AAF_FILTER=1
# Empirical complete-pipeline LoD from the spike-in workflow: 26 / 3891.
AAF_THRESHOLD=0.006682086867129272
MIN_ALT_COUNT=10
MIN_DP=100
MIN_STRAND_ALT=3
MIN_MEAN_BQ=20
MIN_MEAN_MQ=20
MAX_POP_FREQ=0.001
MAX_BINOM_P=1e-6

# Performance and execution
THREADS=8
JAVA_MEM_GB=8
DRY_RUN=0
